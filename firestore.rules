rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function emailVerified() {
      return isSignedIn() && 
             (request.auth.token.get('email_verified', false) == true || 
              request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'customerservice.mme365@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuspended() {
      // Check existing document if we're in the users collection, otherwise use get()
      return isSignedIn() && (
        (request.path[3] == 'users' && request.path[4] == request.auth.uid && 
         resource != null && resource.data.get('isSuspended', false) == true) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuspended', false) == true
      );
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      function isValidUser(data) {
        let keys = ['email', 'balance', 'isAdmin', 'isSuspended', 'profileCompleted', 'createdAt'];
        return data.keys().hasAll(keys) &&
               data.email is string &&
               data.balance is number &&
               data.isAdmin is bool &&
               data.isSuspended is bool &&
               data.profileCompleted is bool &&
               data.createdAt is string &&
               data.get('name', '') is string &&
               data.get('phone', '') is string &&
               (data.get('age', 0) == null || data.get('age', 0) is number) &&
               (data.get('gender', 'other') == null || data.get('gender', 'other') is string) &&
               data.get('country', '') is string &&
               data.get('walletAddress', '') is string &&
               (data.get('purpose', 'Investor') == null || data.get('purpose', 'Investor') is string);
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && 
                      incoming().get('balance', 0) == 0 && 
                      incoming().get('isSuspended', false) == false &&
                      incoming().get('profileCompleted', false) == false &&
                      incoming().get('isAdmin', false) == (incoming().email == 'customerservice.mme365@gmail.com') &&
                      isValidUser(incoming());
                      
      allow update: if (isOwner(userId) && 
                        existing().get('isSuspended', false) == false &&
                        (
                          // Regular profile update
                          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'name', 'phone', 'age', 'gender', 'country', 'purpose', 'updatedAt', 'isSuspended', 'walletAddress']) ||
                          // Balance deduction for usage
                          (incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt']) && 
                           incoming().get('balance', 0) <= existing().get('balance', 0) + 0.0001) ||
                          // Reward logic
                          (incoming().diff(existing()).affectedKeys().hasOnly(['profileCompleted', 'balance', 'name', 'phone', 'age', 'gender', 'country', 'purpose', 'updatedAt', 'walletAddress']) &&
                           existing().get('profileCompleted', false) == false && 
                           incoming().get('profileCompleted', false) == true && 
                           incoming().get('balance', 0) >= existing().get('balance', 0) + 2.4)
                        ) && 
                        incoming().get('isSuspended', false) == existing().get('isSuspended', false) &&
                        incoming().get('isAdmin', false) == existing().get('isAdmin', false) &&
                        isValidUser(incoming())) ||
                     (isAdmin() && isValidUser(incoming()));
    }

    // --- Deposit Rules ---
    match /deposits/{depositId} {
      function isValidDeposit(data) {
        return data.keys().hasAll(['userId', 'userEmail', 'amount', 'currency', 'proof', 'status', 'createdAt']) &&
               data.userId is string && isValidId(data.userId) &&
               data.userEmail is string &&
               data.amount is number && data.amount > 0 &&
               data.currency in ['WAVES', 'BTC', 'ETH', 'SOL', 'USDT', 'BIOTECH'] &&
               data.proof is string && data.proof.size() <= 500 &&
               data.status in ['pending', 'approved', 'rejected'] &&
               data.createdAt is string;
      }

      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && !isSuspended() && 
                      isOwner(incoming().userId) &&
                      incoming().status == 'pending' &&
                      isValidDeposit(incoming());
                      
      allow update: if isAdmin() && isValidDeposit(incoming());
      
      allow delete: if isAdmin();
    }

    // --- Shared Files Rules ---
    match /shared_files/{fileId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Admin list for exists() check
    match /admins/{adminId} {
      allow read: if isSignedIn();
    }
  }
}
